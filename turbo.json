{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "passThroughEnv": ["TMPDIR", "ORAKNID_CI", "ORAKNID_TEST_RCLONE", "ORAKNID_TEST_MINIO_IMAGE"]
    }
  }
}
