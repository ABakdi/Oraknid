# The domain pointed at this machine; Caddy gets its certificate.
NEST_DOMAIN=nest.example.com
# The daemons this Nest accepts: id:secret pairs, comma-separated.
# The secret is long and random (e.g. `openssl rand -base64 32`); give the same
# id and secret to Oraknid at home: Settings → Devices & phone → The Nest → My own Nest.
NEST_DAEMONS=home-1:change-me-to-a-long-random-secret
# private (the default): only the daemons above. public: other daemons register
# themselves too (ADR-031), and NEST_DAEMONS may be empty.
NEST_MODE=private
# In public mode, a code registering needs (empty: anyone may register).
NEST_INVITE=
